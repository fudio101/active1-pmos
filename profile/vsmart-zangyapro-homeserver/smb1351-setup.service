[Unit]
Description=Configure the SMB1351 parallel charger like stock (headless server profile)
After=sysinit.target
# Started from udev on charger changes; never let a burst lock it out.
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/libexec/vsmart-zangyapro-homeserver/smb1351-setup

# No [Install]: the package enables it with its own multi-user.target.wants symlink in /usr/lib
# for the boot-time run (charger already plugged), and the udev rule starts it again after a
# plug-in, whenever the chip has lost its configuration.
