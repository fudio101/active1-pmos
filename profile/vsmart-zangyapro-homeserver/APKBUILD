# Server profile for the Vsmart Active 1: the policy that turns a fresh install into a headless
# home server. LOCAL ONLY. It is never part of an upstream pmaports MR. Hardware fixes belong in
# the kernel / device / firmware packages instead; this package holds only policy.
# Built and added to the rootfs by `dev.sh install`. On a running device:
#   apk add --allow-untrusted vsmart-zangyapro-homeserver-*.apk
pkgname=vsmart-zangyapro-homeserver
pkgver=1
pkgrel=9
pkgdesc="Vsmart Active 1 server profile: headless home-server policy (local, not upstream)"
url="https://github.com/fudio101/active1-pmos"
arch="noarch"
license="MIT"
depends="
	bluez
	device-vsmart-zangyapro
	i2c-tools
	tzdata
	"
options="!check"
source="
	boot-slot-mirror
	boot-slot-mirror.service
	boot-slot-mirror.timer
	boot-slot-record.service
	charge-limit
	charge-limit.service
	console-blank
	console-blank.service
	nm-wifi-mac.conf
	smb1351-setup
	smb1351-setup.service
	smb1351.rules
	timezone.conf
	"

package() {
	local sd="$pkgdir"/usr/lib/systemd/system

	# Blank the panel (DPMS off + backlight off) after 1 min of console idle. Nothing else
	# sets a blank timeout once the tty1 getty is gone. A key press on the VT wakes it.
	install -Dm755 "$srcdir"/console-blank "$pkgdir"/usr/libexec/$pkgname/console-blank
	install -Dm644 "$srcdir"/console-blank.service "$sd"/$pkgname-console-blank.service
	mkdir -p "$sd"/multi-user.target.wants
	ln -s ../$pkgname-console-blank.service "$sd"/multi-user.target.wants/

	# Hold the battery at 70-80 % while plugged in 24/7 (battery = built-in UPS; less
	# swelling and less charging heat). Needs qcom_smbx charge_behaviour: sdm660-mainline
	# qcom-sdm660-7.2.y 636bbe59c66b (correct battery status also needs PR #234,
	# chg-state-change irq). Exits as a no-op on kernels without it (pmaports 7.0.14).
	install -Dm755 "$srcdir"/charge-limit "$pkgdir"/usr/libexec/$pkgname/charge-limit
	install -Dm644 "$srcdir"/charge-limit.service "$sd"/$pkgname-charge-limit.service
	ln -s ../$pkgname-charge-limit.service "$sd"/multi-user.target.wants/

	# Configure the SMB1351 parallel charger like stock (enable pin active high, float 4.40 V).
	# Mainline leaves it on OTP defaults: always enabled with a 4.50 V float, so it charges
	# whenever the PM660 suspends its input (force-discharge). Stopgap until a kernel driver
	# does this. Needs a kernel whose DT enables blsp_i2c2; a no-op otherwise.
	# See .scratch/active1-next-phase/issues/04.
	install -Dm755 "$srcdir"/smb1351-setup "$pkgdir"/usr/libexec/$pkgname/smb1351-setup
	install -Dm644 "$srcdir"/smb1351-setup.service "$sd"/$pkgname-smb1351-setup.service
	ln -s ../$pkgname-smb1351-setup.service "$sd"/multi-user.target.wants/
	install -Dm644 "$srcdir"/smb1351.rules "$pkgdir"/usr/lib/udev/rules.d/90-$pkgname-smb1351.rules

	# Keep the serial-derived WiFi MAC from bootmac, so DHCP reservations survive reinstalls.
	install -Dm644 "$srcdir"/nm-wifi-mac.conf \
		"$pkgdir"/usr/lib/NetworkManager/conf.d/60-$pkgname-wifi-mac.conf

	# Start Bluetooth at boot (BT keyboard on the headless box). This used to live in the
	# device package; upstream it is a user choice, so it moved here.
	ln -s ../bluetooth.service "$sd"/multi-user.target.wants/

	# Keep the other A/B boot slot as a copy of a boot image that has proven itself, so a
	# kernel that fails to boot falls back to a pmOS kernel and not the stock Android one.
	install -Dm755 "$srcdir"/boot-slot-mirror "$pkgdir"/usr/libexec/$pkgname/boot-slot-mirror
	install -Dm644 "$srcdir"/boot-slot-record.service "$sd"/$pkgname-boot-slot-record.service
	install -Dm644 "$srcdir"/boot-slot-mirror.service "$sd"/$pkgname-boot-slot-mirror.service
	install -Dm644 "$srcdir"/boot-slot-mirror.timer "$sd"/$pkgname-boot-slot-mirror.timer
	ln -s ../$pkgname-boot-slot-record.service "$sd"/multi-user.target.wants/
	mkdir -p "$sd"/timers.target.wants
	ln -s ../$pkgname-boot-slot-mirror.timer "$sd"/timers.target.wants/

	# System clock in Vietnam time (Asia/Ho_Chi_Minh, UTC+7).
	install -Dm644 "$srcdir"/timezone.conf "$pkgdir"/usr/lib/tmpfiles.d/$pkgname-timezone.conf

	# No login prompt on the panel: agetty 2.42 reprints "login:" on every IP address
	# netlink event, so the panel fills up. Keyboard login still works on tty2 (Ctrl+Alt+F2,
	# logind autovt). See .scratch/active1-next-phase/issues/14.
	ln -s /dev/null "$sd"/getty@tty1.service
}
